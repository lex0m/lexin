<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.lex0m.lexin"
    android:versionCode="71"
    android:versionName="1.7.22">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />

    <!-- 「每日一言」要联网取一句话；只有这一条权限，模块不在后台跑任何网络任务 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 9（minSdk 28）上把语音 MP3 写进公共 Download/乐信/语音 需要它；
         10+ 一律走 MediaStore，不需要任何存储权限（maxSdkVersion 保证高版本不申请） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 转码完成后发通知（33+ 需要用户授予，拒绝也不影响文件落盘） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 语音导出的「信箱」在公共 Downloads 下，而文件是微信写的：
         Android 11+ 的 scoped storage 规定应用只能查到自己创建的文件，
         所以必须拿「所有文件访问」才能看到微信放进来的待转换文件。 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- 常驻监听：微信把待转换语音写进工作目录后，不依赖用户手动打开 App 就能转码 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 保活：请用户把乐信加入电池优化白名单（面板里有入口） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android 11+ 包可见性：跳板要用显式组件拉起微信的 LauncherUI，面板里也要能打开自己的设置页 -->
    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="io.github.lex0m.lexin" />
    </queries>

    <application
        android:name=".LexinApp"
        android:extractNativeLibs="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hasCode="true">

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="@string/app_name" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedsharedprefs" android:value="true" />
        <!-- 作用域声明：LSPosed 据此在作用域界面把微信列为推荐应用 -->
        <meta-data android:name="xposedscope" android:resource="@array/xposedscope" />

        <!-- 启动跳板：LSPosed 模块页右下角的 ▶ 和桌面图标都走这里。
             它本身没有界面，只负责把微信拉起来并让模块在微信进程里打开面板
             （面板必须在微信进程里跑，跨进程配置在 Android 15 上走不通）。
             launcher 入口必须放在这个 activity 上：LSPosed 认的是「模块有可解析的
             launcher activity」（实测禁用组件不算数）。 -->
        <activity
            android:name=".EntryPointActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 设置页：模块自己的界面（不依赖微信），从跳板兜底或面板里进入 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />

        <!-- v1.7.11 无界面诊断导出：adb shell am start -n io.github.lex0m.lexin/.DiagActivity
             只给 root / shell 用（exported=false），普通 App 拉不动 -->
        <activity
            android:name=".DiagActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!-- v1.7.3 常驻监听 + 开机自启 -->
        <service
            android:name=".WorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Serves the chosen background to the hook side. The image lives in the
             module's private dir (invisible to WeChat); this provider is the only
             way the host process can read it without us writing into WeChat's own
             storage. It exposes exactly one file and nothing else. -->
        <!-- 配置总线：微信进程 ⇄ 模块进程的唯一通道（provider 被包可见性封死，只能走广播）。
             只认两条短 action，别的什么都不做；exported 是必须的（发送方是微信，另一个 uid）。 -->
        <receiver
            android:name=".CfgReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="x.q" />
                <action android:name="x.p" />
                <action android:name="x.s" />
                <action android:name="x.c" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".BgProvider"
            android:authorities="io.github.lex0m.lexin.bg"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- 语音转 MP3：由微信进程里的模块拉起（跨进程做解码，微信进程保持零 native） -->
        <activity
            android:name=".ConvertActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Appearance screen: second level, reached from the main menu. -->
        <activity
            android:name=".ThemeActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />

    </application>

</manifest>
